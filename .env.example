# Required for a non-demo runtime
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/careshield
AUTH_SECRET=generate-a-32-byte-base64-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional in Vercel; set locally when testing OAuth callback URLs.
AUTH_URL=https://your-production-domain.example
# Meta WhatsApp Cloud API readiness (required only when notifications are enabled).
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v22.0
# Required for signed inbound Meta webhook verification.
META_WEBHOOK_VERIFY_TOKEN=generate-a-long-random-value
META_APP_SECRET=
# Production OCR/vision adapter (never use demo fallback in production).
MEDICINE_VISION_ENDPOINT=
MEDICINE_VISION_API_KEY=
# Never enable outside development/test. Demo accounts are provisioned only in demo mode.
CARESHIELD_DEMO_MODE=false
