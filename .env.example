# Required for a non-demo runtime
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/careshield
AUTH_SECRET=generate-a-32-byte-base64-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional in Vercel; set locally when testing OAuth callback URLs.
AUTH_URL=https://your-production-domain.example
# Live WhatsApp Cloud API outbound messaging (required for production delivery).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Available for WABA/account APIs; not required by the outbound /messages endpoint.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Graph API version. Defaults to the application's documented v22.0 compatibility default.
WHATSAPP_API_VERSION=v22.0
# Name of an approved Meta emergency template. Defaults to careshield_emergency.
WHATSAPP_EMERGENCY_TEMPLATE=careshield_emergency
# Required for inbound webhook subscription verification and signed delivery/status callbacks.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate-a-long-random-value
META_APP_SECRET=
# Production OCR/vision adapter (never use demo fallback in production).
MEDICINE_VISION_ENDPOINT=
MEDICINE_VISION_API_KEY=
# Never enable outside development/test. Demo accounts are provisioned only in demo mode.
CARESHIELD_DEMO_MODE=false
